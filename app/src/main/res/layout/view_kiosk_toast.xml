<?xml version="1.0" encoding="utf-8"?>
<!-- Thẻ thông báo dùng chung (Figma "Alert"): 343 x ≥72, padding 16, icon 24 cách chữ 8, chữ Inter 16/20 #666666.
     Nền + icon theo kiểu (thành công / cảnh báo) đặt trong KioskToast. -->
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/toast"
    android:layout_width="@dimen/toast_min_width"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/toast_min_height"
    android:orientation="horizontal"
    android:paddingStart="@dimen/toast_padding_start"
    android:paddingTop="@dimen/toast_padding_v"
    android:paddingEnd="@dimen/toast_padding_end"
    android:paddingBottom="@dimen/toast_padding_v"
    tools:background="@drawable/bg_toast_success">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivIcon"
        android:layout_width="@dimen/toast_icon"
        android:layout_height="@dimen/toast_icon"
        android:importantForAccessibility="no"
        tools:srcCompat="@drawable/ic_toast_success" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/toast_icon_gap"
        android:layout_weight="1"
        android:fontFamily="@font/inter_24pt_regular"
        android:textColor="@color/toast_text"
        android:textSize="@dimen/toast_text"
        app:lineHeight="@dimen/toast_text_line"
        tools:text="Gửi đánh giá thành công" />
</androidx.appcompat.widget.LinearLayoutCompat>
