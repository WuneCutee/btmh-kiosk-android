<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/header"
        android:name="vn.btmh.ui.fragments.header.HeaderFragment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/layoutProgress"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginHorizontal="@dimen/header_padding_h"
        android:layout_marginTop="24dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/header">

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_progress_active" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:background="@drawable/bg_progress_active" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:background="@drawable/bg_progress_inactive" />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/boxCenter"
        android:layout_width="640dp"
        android:layout_height="640dp"
        android:layout_marginHorizontal="@dimen/header_padding_h"
        android:layout_marginTop="112dp"
        app:layout_constraintBottom_toTopOf="@id/tvInstruction"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutProgress"
        app:layout_constraintVertical_bias="0.4">

        <vn.btmh.ui.customviews.DashedCircleView
            android:id="@+id/dashedCircleView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivFaceId"
            android:layout_width="114dp"
            android:layout_height="114dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_face_id" />

    </FrameLayout>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvInstruction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/header_padding_h"
        android:layout_marginTop="112dp"
        android:fontFamily="@font/inter_24pt_regular"
        android:gravity="center"
        android:lineSpacingExtra="8dp"
        android:text="@string/txt_vui_l_ng_nh_n_th_ng_v_gi_khu_n"
        android:textColor="#000000"
        android:textSize="26sp"
        app:layout_constraintTop_toBottomOf="@id/boxCenter" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnScan"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginHorizontal="@dimen/header_padding_h"
        android:layout_marginBottom="42dp"
        android:background="@drawable/bg_pill_red"
        android:fontFamily="@font/inter_24pt_semibold"
        android:text="@string/txt_b_t_u_qu_t"
        android:textColor="@color/white"
        android:textSize="24sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:textAllCaps="false" />

</androidx.constraintlayout.widget.ConstraintLayout>
