<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/header"
        android:name="vn.btmh.ui.fragments.header.HeaderFragment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvGuideTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/header_padding_h"
        android:layout_marginTop="32dp"
        android:fontFamily="@font/inter_24pt_semibold"
        android:text="@string/txt_h_ng_d_n"
        android:textColor="#1A1A1A"
        android:textSize="32sp"
        app:layout_constraintTop_toBottomOf="@id/header" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvGuideDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/header_padding_h"
        android:layout_marginTop="24dp"
        android:fontFamily="@font/inter_24pt_regular"
        android:lineSpacingExtra="8dp"
        android:text="@string/txt_s_d_ng_gi_y_t_g_c_b_n_ch_nh_ch"
        android:textColor="#504F4F"
        android:textSize="22sp"
        app:layout_constraintTop_toBottomOf="@id/tvGuideTitle" />

    <LinearLayout
        android:id="@+id/boxIDCard"
        android:layout_width="match_parent"
        android:layout_height="500dp"
        android:layout_marginHorizontal="@dimen/header_padding_h"
        android:layout_marginTop="56dp"
        android:layout_marginBottom="56dp"
        android:background="@drawable/bg_dashed_green"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/layoutBottom"
        app:layout_constraintTop_toBottomOf="@id/tvGuideDesc">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:src="@drawable/ic_card" />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="42dp"
            android:fontFamily="@font/inter_24pt_regular"
            android:text="@string/txt_m_t_tr_c_h_ng_l_n"
            android:textColor="#4CAF50"
            android:textSize="24sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/header_padding_h"
        android:layout_marginBottom="42dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/cbPolicy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:button="@drawable/selector_checkbox"
                android:buttonTint="@null"
                android:checked="false"
                android:paddingStart="16dp"
                android:scaleX="1.2"
                android:scaleY="1.2"
                app:buttonTint="@null" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvPolicy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:fontFamily="@font/inter_24pt_regular"
                android:lineSpacingExtra="8dp"
                android:text="@string/txt_t_i_ng_cho_btmh_thu_th_p_v_x_l_1"
                android:textColor="#1A1A1A"
                android:textSize="20sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnVneid"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_red"
                android:fontFamily="@font/inter_24pt_semibold"
                android:text="@string/txt_s_d_ng_vneid"
                android:textColor="@color/white"
                android:textSize="24sp"
                app:textAllCaps="false" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCccd"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_red"
                android:fontFamily="@font/inter_24pt_semibold"
                android:text="@string/txt_s_d_ng_cccd"
                android:textColor="@color/white"
                android:textSize="24sp"
                app:textAllCaps="false" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
