<?xml version="1.0" encoding="utf-8"?>
<!-- Kết quả giao dịch (VIII, IX, X) — Figma "Màn hình kết thúc thanh toán". -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg">

    <FrameLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/payment_padding_h"
        android:paddingBottom="@dimen/order_content_bottom"
        app:layout_constraintBottom_toTopOf="@id/btnContinue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/result_status_top"
                android:fontFamily="@font/inter_24pt_semibold"
                android:gravity="center"
                android:textColor="@color/black"
                android:textSize="@dimen/result_status_text"
                app:lineHeight="@dimen/result_status_line"
                tools:text="Giao dịch thành công" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/result_time_top"
                android:fontFamily="@font/inter_24pt_italic"
                android:textColor="@color/result_time"
                android:textSize="@dimen/result_time_text"
                app:lineHeight="@dimen/result_time_line"
                tools:text="19:09:09 27/07/2026" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/result_caption_top"
                android:textColor="@color/black"
                android:textSize="@dimen/result_small_text"
                app:lineHeight="@dimen/result_caption_line"
                tools:text="@string/result_scan_zalo" />

            <FrameLayout
                android:id="@+id/qrBox"
                android:layout_width="@dimen/result_qr_size"
                android:layout_height="@dimen/result_qr_size"
                android:layout_marginTop="@dimen/result_qr_top"
                android:background="@drawable/bg_qr_card"
                android:elevation="@dimen/payment_qr_elevation"
                android:padding="@dimen/result_qr_padding">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivQr"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/result_zalo_description"
                    android:scaleType="fitCenter" />

                <ProgressBar
                    android:id="@+id/qrProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/brand_red"
                    android:visibility="gone" />

                <!-- Logo Zalo giữa QR (Figma); mã vẽ ở mức sửa lỗi H nên che cỡ này vẫn quét được. -->
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvQrLogo"
                    android:layout_width="@dimen/result_zalo_logo"
                    android:layout_height="@dimen/result_zalo_logo"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_zalo_logo"
                    android:fontFamily="@font/inter_24pt_semibold"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:text="@string/result_zalo_logo"
                    android:textColor="@color/white"
                    android:textSize="@dimen/result_zalo_logo_text" />
            </FrameLayout>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/result_message_inset"
                android:layout_marginTop="@dimen/result_message_top"
                android:textColor="@color/black"
                android:textSize="@dimen/result_message_text"
                app:lineHeight="@dimen/result_message_line"
                tools:text="Thanh toán đơn hàng thất bại…" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/result_info_top"
                android:orientation="vertical"
                android:paddingStart="@dimen/payment_inset">

                <include
                    android:id="@+id/rowCustomer"
                    layout="@layout/item_payment_row" />

                <include
                    android:id="@+id/rowOrderCode"
                    layout="@layout/item_payment_row" />

                <include
                    android:id="@+id/rowAmount"
                    layout="@layout/item_payment_row" />

                <include
                    android:id="@+id/rowStore"
                    layout="@layout/item_payment_row" />
            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/result_thanks_top"
                android:fontFamily="@font/inter_24pt_bold"
                android:text="@string/result_thanks"
                android:textColor="@color/black"
                android:textSize="@dimen/result_thanks_text"
                app:lineHeight="@dimen/result_thanks_line" />

            <!-- Figma: "Chạm để đánh giá" + 5 sao 40x38 cách 15, khối cách nhau 8. Chỉ hiện ở giao dịch thành công. -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/result_rate_gap"
                    android:text="@string/result_rate"
                    android:textColor="@color/black"
                    android:textSize="@dimen/result_small_text"
                    app:lineHeight="@dimen/result_caption_line" />

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/stars"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/result_rate_gap"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/star1"
                        android:layout_width="@dimen/result_star_width"
                        android:layout_height="@dimen/result_star_height"
                        app:srcCompat="@drawable/ic_rating_star" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/star2"
                        android:layout_width="@dimen/result_star_width"
                        android:layout_height="@dimen/result_star_height"
                        android:layout_marginStart="@dimen/result_star_gap"
                        app:srcCompat="@drawable/ic_rating_star" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/star3"
                        android:layout_width="@dimen/result_star_width"
                        android:layout_height="@dimen/result_star_height"
                        android:layout_marginStart="@dimen/result_star_gap"
                        app:srcCompat="@drawable/ic_rating_star" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/star4"
                        android:layout_width="@dimen/result_star_width"
                        android:layout_height="@dimen/result_star_height"
                        android:layout_marginStart="@dimen/result_star_gap"
                        app:srcCompat="@drawable/ic_rating_star" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/star5"
                        android:layout_width="@dimen/result_star_width"
                        android:layout_height="@dimen/result_star_height"
                        android:layout_marginStart="@dimen/result_star_gap"
                        app:srcCompat="@drawable/ic_rating_star" />
                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/hotline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/result_hotline_top"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="@dimen/result_hotline_icon"
                    android:layout_height="@dimen/result_hotline_icon"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/ic_phone_call" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvHotline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/result_hotline_gap"
                    android:textColor="@color/black"
                    android:textSize="@dimen/result_message_text"
                    app:lineHeight="@dimen/result_message_line"
                    tools:text="1800.2209" />
            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvAutoEnd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/result_message_inset"
                android:layout_marginTop="@dimen/result_warning_top"
                android:fontFamily="@font/inter_24pt_italic"
                android:gravity="center"
                android:textColor="@color/result_warning"
                android:textSize="@dimen/result_message_text"
                app:lineHeight="@dimen/result_message_line"
                tools:text="Phiên giao dịch sẽ tự động kết thúc sau 120 giây nếu quý khách không tiếp tục." />
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.core.widget.NestedScrollView>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/btnContinue"
        style="@style/OrderButton"
        android:layout_width="0dp"
        android:layout_height="@dimen/result_button_height"
        android:layout_marginHorizontal="@dimen/result_button_side"
        android:layout_marginBottom="@dimen/result_button_bottom"
        android:background="@drawable/bg_pill_red"
        android:text="@string/result_continue"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
