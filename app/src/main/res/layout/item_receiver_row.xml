<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="@dimen/order_card_row_padding"
    android:orientation="horizontal">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/order_receiver_label"
        android:textSize="@dimen/order_receiver_row_text"
        app:lineHeight="@dimen/order_line_16"
        tools:text="Người nhận" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.4"
        android:fontFamily="@font/inter_24pt_semibold"
        android:gravity="end"
        android:textColor="@color/order_value"
        android:textSize="@dimen/order_receiver_row_text"
        app:lineHeight="@dimen/order_line_16"
        tools:text="Nguyễn Văn A" />
</androidx.appcompat.widget.LinearLayoutCompat>
